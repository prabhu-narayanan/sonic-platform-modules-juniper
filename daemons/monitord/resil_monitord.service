[Unit]
Description=FPGA/CPLD Scratch Register Monitor
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/resil_monitord
Restart=always
RestartSec=5s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=resil_monitord

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
