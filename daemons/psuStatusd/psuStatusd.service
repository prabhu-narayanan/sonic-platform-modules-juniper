[Unit]
Description=Juniper PSU Status/Failure Monitoring Daemon
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/psuStatusd
Restart=always
RestartSec=5s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=psuStatusd

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
