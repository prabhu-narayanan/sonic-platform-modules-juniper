[Unit]
Description=dc-jma container (Juniper Mist Agent)
Requires=database.service
After=database.service swss.service syncd.service
BindsTo=sonic.target
After=sonic.target
StartLimitIntervalSec=1200
StartLimitBurst=3

[Service]
ExecStartPre=/usr/local/bin/dc-jma.sh start
ExecStart=/usr/local/bin/dc-jma.sh wait
ExecStop=/usr/local/bin/dc-jma.sh stop
RestartSec=30
Restart=on-failure
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=sonic.target
