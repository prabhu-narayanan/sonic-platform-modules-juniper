%:
	dh $@

override_dh_auto_build:
	$(MAKE)

override_dh_auto_install:
	install -d debian/libsaigearbox/usr/lib
	install -m 644 output/libbrcm_pai.so debian/libsaigearbox/usr/lib/libsai.so.1.0
	ln -sf libsai.so.1.0 debian/libsaigearbox/usr/lib/libsai.so.1
	ln -sf libsai.so.1 debian/libsaigearbox/usr/lib/libsai.so

override_dh_auto_clean:
	$(MAKE) clean || true

override_dh_shlibdeps:
	# Skip - self-contained .so with no external deps beyond libc/libm/libpthread
