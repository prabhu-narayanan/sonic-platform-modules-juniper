+++ b/inc/brcm_pai_db.h	2026-09-07 00:00:00.000000000 +0530
@@ -77,8 +77,8 @@
 
 typedef struct brcm_slave_phyid_list_s
 {
-    uint8_t count;
-    uint8_t list[BRCM_MAX_PHY_ON_MDIO_BUS];
+    uint32_t count;
+    uint32_t list[BRCM_MAX_PHY_ON_MDIO_BUS];
 } brcm_slave_phyid_list_t;
 
