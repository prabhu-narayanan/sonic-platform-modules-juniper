+    /* Some packages (e.g. BCM84894) present each lane as an independently
+     * MDIO-addressable core at <package_base + local_lane>. On those devices
+     * the lane_map does NOT select the core - the MDIO address does - so
+     * addressing the package base leaves every core but one unconfigured.
+     *
+     * Detect that layout from the configuration itself: if the platform has
+     * declared a chip id (phy_init_config_chip_id) at <package_base +
+     * local_lane>, address that core directly and hand EPDM a single-lane
+     * lane_map. Platforms that declare a single chip id per package have no
+     * such entry, so the lookup fails and the package-base behaviour is left
+     * untouched.
+     *
+     * Note the config DB (PAI_MODULE_CFG_PHY, part number 0 in the key) is
+     * used here, not PAI_MODULE_PHY: the latter is populated only by
+     * create_switch(), so it holds just the package bases. Only the address
+     * is overridden - every core in a package shares the MDIO bus of its
+     * base, so the base's platform_ctxt stays valid.
+     */
+    if (BRCM_PAI_BFIN_SUPPORT(port_info->chip_name) &&
+        port_info->lane_map != 0 &&
+        (port_info->lane_map & (port_info->lane_map - 1)) == 0) {
+        /* Single-lane port: lane_map has exactly one bit, and its position is
+         * the local lane number assigned in _brcm_process_hw_lane_list(). */
+        int local_lane = 0;
+        uint32_t lane_map = (uint32_t) port_info->lane_map;
+        pai_phy_t core_cfg;
+        sai_object_id_t core_cfg_obj_id;
+
+        while ((lane_map >>= 1) != 0) {
+            local_lane++;
+        }
+
+        if (local_lane != 0) {
+            /* Kept in a local: BRCM_PAI_CREATE_OBJ_ID() ORs its id argument, so
+             * passing an unparenthesised sum trips -Wparentheses. */
+            int core_addr = phy_id + local_lane;
+
+            core_cfg_obj_id = BRCM_PAI_CREATE_OBJ_ID(SAI_OBJECT_TYPE_SWITCH,
+                0, 0, core_addr);
+            if (pai_db_read_module(PAI_MODULE_CFG_PHY, core_cfg_obj_id, &core_cfg)
+                    == SAI_STATUS_SUCCESS) {
+                plp_info->phy_addr = core_addr;
+                plp_info->lane_map = 0x1;
+                PAI_LOG_DEBUG(SAI_API_PORT, "Per-core addressing: package base %d,"
+                    " local lane %d -> phy_addr %d\n", phy_id, local_lane,
+                    plp_info->phy_addr);
+            }
+        }
+    }
+
     return SAI_STATUS_SUCCESS;
 }
 
